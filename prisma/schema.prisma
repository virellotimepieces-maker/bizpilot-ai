generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  createdAt    DateTime       @default(now())
  memberships  Membership[]
  notifications Notification[]
  subscriptions Subscription[]
}

model Workspace {
  id            String         @id @default(cuid())
  name          String
  ownerUserId   String
  widgetKey     String         @unique
  knowledge     Json?
  createdAt     DateTime       @default(now())
  memberships   Membership[]
  subscription  Subscription?
  usagePeriods  UsagePeriod[]
  notifications Notification[]
  conversations Conversation[]
  websiteSource WebsiteSource?
  websitePages  WebsitePage[]
  socialMessages SocialMessage[]
  emailDrafts    EmailDraft[]
  gmailConnection GmailConnection?
  gmailReplyDrafts GmailReplyDraft[]
  shopifyConnection ShopifyConnection?
  shopifyProducts ShopifyProduct[]
  knowledgeEntries KnowledgeEntry[]
  unansweredQuestions UnansweredQuestion[]
  leads         Lead[]
  quoteRequests QuoteRequest[]
  appointmentRequests AppointmentRequest[]
  widgetSettings WidgetSettings?
  integrationConnections IntegrationConnection[]
  googleCalendarConnection GoogleCalendarConnection?
  calendarBookingSettings CalendarBookingSettings?
  calendarBookingSessions CalendarBookingSession[]
  calendarAppointments CalendarAppointment[]
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Subscription {
  id                   String        @id @default(cuid())
  workspaceId          String        @unique
  userId               String
  stripeCustomerId     String?
  stripeSubscriptionId String?       @unique
  stripePriceId        String?
  status               String
  cancelAtPeriodEnd    Boolean       @default(false)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  canceledAt           DateTime?
  updatedAt            DateTime      @updatedAt
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace            Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  usagePeriods         UsagePeriod[]

  @@index([userId])
}

model UsagePeriod {
  id             String       @id @default(cuid())
  workspaceId    String
  subscriptionId String
  periodStart    DateTime
  periodEnd      DateTime
  replyLimit     Int
  repliesUsed    Int          @default(0)
  repliesReserved Int         @default(0)
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, periodStart])
}

model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  type        String
  message     String
  relatedType String    @default("")
  relatedId   String    @default("")
  createdAt   DateTime  @default(now())
  readAt      DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, workspaceId])
  @@index([workspaceId, createdAt])
}

model Conversation {
  id               String    @id @default(cuid())
  workspaceId      String
  visitorKey       String
  waitingOnHuman   Boolean   @default(false)
  visitorName      String    @default("")
  visitorEmail     String    @default("")
  visitorPhone     String    @default("")
  channel          String    @default("website")
  customerIntent   String    @default("general_question")
  inboxStatus      String    @default("open")
  ownerLastReadAt  DateTime?
  lastMessageAt    DateTime  @default(now())
  aiSummary        String    @default("")
  detectedLanguage String    @default("")
  createdAt        DateTime  @default(now())
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages         Message[]
  leads            Lead[]
  quoteRequests    QuoteRequest[]
  appointmentRequests AppointmentRequest[]
  unansweredQuestions UnansweredQuestion[]
  calendarBookingSession CalendarBookingSession?
  calendarAppointments CalendarAppointment[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, inboxStatus])
  @@index([workspaceId, waitingOnHuman])
  @@index([workspaceId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  workspaceId    String
  conversationId String
  role           String
  content        String
  usageCounted   Boolean      @default(false)
  sources        Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([workspaceId, conversationId])
}

model WebsiteSource {
  id                 String        @id @default(cuid())
  workspaceId        String        @unique
  widgetKey          String
  domain             String
  verifyToken        String
  verifiedAt         DateTime?
  lastSyncAt         DateTime?
  nextSyncAt         DateTime?
  lastSyncStatus     String        @default("idle")
  lastSyncError      String?
  lastSyncDiagnostic String?
  lastSyncPageCount  Int           @default(0)
  conflictWarning    String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  workspace          Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pages              WebsitePage[]

  @@index([widgetKey])
  @@index([nextSyncAt])
}

model WebsitePage {
  id           String         @id @default(cuid())
  workspaceId  String
  widgetKey    String
  sourceId     String
  url          String
  title        String
  kind         String
  content      String
  contentHash  String
  lastModified DateTime?
  fetchedAt    DateTime
  source       WebsiteSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, url])
  @@index([workspaceId, widgetKey])
}

model SocialMessage {
  id                    String    @id @default(cuid())
  workspaceId           String
  widgetKey             String
  platform              String
  fromName              String
  handle                String
  body                  String
  conversationUrl       String?
  status                String
  draftBody             String
  intent                String
  sources               Json?
  operatorNote          String
  usedInternalKnowledge Boolean   @default(false)
  postedAt              DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, widgetKey])
}

model EmailDraft {
  id                    String    @id @default(cuid())
  workspaceId           String
  widgetKey             String
  fromName              String
  fromEmail             String
  subject               String
  body                  String
  status                String
  draftSubject          String
  draftBody             String
  intent                String
  sources               Json?
  operatorNote          String
  usedInternalKnowledge Boolean   @default(false)
  sentAt                DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, widgetKey])
}

model GmailConnection {
  id                    String    @id @default(cuid())
  workspaceId           String    @unique
  googleEmail           String
  googleSub             String?
  encryptedRefreshToken String
  encryptedAccessToken  String
  accessTokenExpiresAt  DateTime
  scopes                String
  status                String
  connectedAt           DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model GmailReplyDraft {
  id                    String    @id @default(cuid())
  workspaceId           String
  gmailMessageId        String
  gmailThreadId         String
  rfcMessageId          String?
  fromName              String
  fromEmail             String
  subject               String
  body                  String
  receivedAt            DateTime?
  draftSubject          String
  draftBody             String
  intent                String
  sources               Json?
  operatorNote          String
  usedInternalKnowledge Boolean   @default(false)
  status                String
  sentAt                DateTime?
  sendLockAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, gmailMessageId])
  @@index([workspaceId, createdAt])
}

model KnowledgeEntry {
  id            String    @id @default(cuid())
  workspaceId   String
  kind          String
  title         String
  content       String
  enabled       Boolean   @default(true)
  sourceType    String    @default("manual")
  sourceUrl     String    @default("")
  sourceLabel   String    @default("")
  sourceRef     String    @default("")
  lastUpdatedAt DateTime  @updatedAt
  createdAt     DateTime  @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, kind])
  @@index([workspaceId, enabled])
  @@index([workspaceId, lastUpdatedAt])
}

model UnansweredQuestion {
  id               String        @id @default(cuid())
  workspaceId      String
  conversationId   String?
  question         String
  detectedLanguage String        @default("")
  status           String        @default("open")
  createdAt        DateTime      @default(now())
  resolvedAt       DateTime?
  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation     Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

model Lead {
  id             String        @id @default(cuid())
  workspaceId    String
  conversationId String?
  name           String        @default("")
  email          String        @default("")
  phone          String        @default("")
  interest       String        @default("")
  request        String        @default("")
  notes          String        @default("")
  source         String        @default("website")
  status         String        @default("new")
  intent         String        @default("general_question")
  aiSummary      String        @default("")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  quoteRequests  QuoteRequest[]
  appointmentRequests AppointmentRequest[]

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, conversationId])
}

model QuoteRequest {
  id             String        @id @default(cuid())
  workspaceId    String
  conversationId String?
  leadId         String?
  customerName   String        @default("")
  email          String        @default("")
  phone          String        @default("")
  productService String        @default("")
  requirements   String        @default("")
  notes          String        @default("")
  status         String        @default("requested")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

model AppointmentRequest {
  id               String        @id @default(cuid())
  workspaceId      String
  conversationId   String?
  leadId           String?
  customerName     String        @default("")
  email            String        @default("")
  phone            String        @default("")
  requestedService String        @default("")
  preferredAt      String        @default("")
  notes            String        @default("")
  status           String        @default("requested")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation     Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  lead             Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

model WidgetSettings {
  id                   String    @id @default(cuid())
  workspaceId          String    @unique
  businessDisplayName  String    @default("")
  logoUrl              String    @default("")
  welcomeMessage       String    @default("")
  suggestedQuestions   Json
  accentColor          String    @default("")
  position             String    @default("bottom-right")
  identifyAsAi         Boolean   @default(true)
  collectPhone         Boolean   @default(false)
  leadCaptureEnabled   Boolean   @default(true)
  placeholderPrompt    String    @default("")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ShopifyConnection {
  id                   String    @id @default(cuid())
  workspaceId          String    @unique
  shopDomain           String    @unique
  shopName             String    @default("")
  primaryDomain        String    @default("")
  encryptedAccessToken String
  scopes               String
  status               String
  lastSyncedAt         DateTime?
  lastSyncStatus       String    @default("idle")
  lastSyncError        String?
  productCount         Int       @default(0)
  connectedAt          DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ShopifyProduct {
  id                String    @id @default(cuid())
  workspaceId       String
  shopifyProductId  String
  handle            String
  title             String
  description       String    @default("")
  status            String
  productType       String    @default("")
  vendor            String    @default("")
  tags              String    @default("")
  url               String    @default("")
  imageUrls         Json
  variants          Json
  publishedAt       DateTime?
  shopifyUpdatedAt  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, shopifyProductId])
  @@index([workspaceId, status])
  @@index([workspaceId])
}

model IntegrationConnection {
  id          String    @id @default(cuid())
  workspaceId String
  provider    String
  status      String    @default("disconnected")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@index([workspaceId])
}

model GoogleCalendarConnection {
  id                    String    @id @default(cuid())
  workspaceId           String    @unique
  googleEmail           String
  googleSub             String?
  encryptedRefreshToken String
  encryptedAccessToken  String
  accessTokenExpiresAt  DateTime
  scopes                String
  status                String
  calendarId            String    @default("primary")
  calendarSummary       String    @default("Primary")
  connectedAt           DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model CalendarBookingSettings {
  id                String    @id @default(cuid())
  workspaceId       String    @unique
  durationMinutes   Int       @default(30)
  availableDays     Json
  startMinutes      Int       @default(540)
  endMinutes        Int       @default(1020)
  timezone          String    @default("UTC")
  minNoticeMinutes  Int       @default(60)
  bufferMinutes     Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model CalendarBookingSession {
  id              String    @id @default(cuid())
  workspaceId     String
  conversationId  String    @unique
  customerName    String    @default("")
  email           String    @default("")
  service         String    @default("")
  offeredSlots    Json
  status          String    @default("collecting")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model CalendarAppointment {
  id               String    @id @default(cuid())
  workspaceId      String
  conversationId   String?
  customerName     String
  email            String
  service          String    @default("")
  startsAt         DateTime
  endsAt           DateTime
  timezone         String
  googleEventId    String    @default("")
  googleCalendarId String
  holdKey          String
  status           String    @default("confirmed")
  confirmationSentAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation     Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, holdKey])
  @@index([workspaceId, startsAt])
}
