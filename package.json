{
  "name": "bizpilot-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 43127 --hostname 0.0.0.0",
    "build": "node scripts/migrate-production.cjs && next build",
    "start": "next start --port 43127",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/assert-legacy-brand.mjs && tsx --test lib/reply-engine.test.ts lib/billing/billing.test.ts lib/hours-display.test.ts lib/knowledge-save-state.test.ts lib/hours-editor.test.ts lib/widget-preview.test.ts lib/widget-install-guides.test.ts lib/widget-embed-script.test.ts lib/widget-chat-scroll.test.ts",
    "postinstall": "prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "jose": "^6.1.0",
    "lucide-react": "^1.44.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "stripe": "^18.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^6.16.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
