# Copy to .env.local for this BizPilot project only.
# Do not reuse databases or Stripe keys from other apps.

# PostgreSQL for BizPilot AI (required for signup, paid workspaces, usage)
DATABASE_URL=

# Sign login cookies (32+ random characters)
AUTH_SECRET=

# Public origin used in Stripe redirects and the widget snippet
APP_URL=http://127.0.0.1:43217

# Stripe for THIS BizPilot project
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PUBLISHABLE_KEY=

# Paid widget AI replies (counted only after a successful response)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional. Protects scheduled website re-sync if you call /api/cron/website-sync yourself.
CRON_SECRET=
